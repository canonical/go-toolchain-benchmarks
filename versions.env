# Immutable version pins for the Go toolchain benchmark campaign.
# Sourced by all DUT scripts. Update here only; nothing else hardcodes versions.

# Go toolchains under comparison (linux/amd64).
GO_BASELINE_VERSION=1.26.7
GO_EXPERIMENT_VERSION=1.27.0
# SHA-256 of the linux-amd64 tarballs, from https://go.dev/dl/?mode=json&include=all
GO_BASELINE_SHA256=ffb5f8de10c62550dfddab66b36b57030721e0a44a3218e9e1181d7b59f121ca
GO_EXPERIMENT_SHA256=675c26c449cbb18fc24b74650de1eabbae6e16f64326fd85a283fb3b58280685
GO_DOWNLOAD_BASE=https://go.dev/dl

# Immutable GOROOT install locations on the DUT.
BASE_GOROOT=/opt/go1.26.7
EXP_GOROOT=/opt/go1.27.0

# Benchmark sources. golang.org/x/benchmarks has no tags/releases, so pin commits.
BENCHMARKS_REPO=https://go.googlesource.com/benchmarks
BENCHMARKS_COMMIT=70693762b6a0d7f393892f0ace40979e3cbe5737
# golang.org/x/perf provides benchstat.
XPERF_REPO=https://go.googlesource.com/perf
XPERF_COMMIT=ebcb4798430da1bb6761f0a1c8921251caba88de

# Run counts.
# x/benchmarks: -count per pass; two passes (B,E then E,B) => 6 observations/toolchain.
XBENCH_COUNT=3
# Sweet default run count.
SWEET_COUNT=10

# Sweet config names (must match scripts/sweet-config.toml).
BASE_CONFIG_NAME=go1.26.7
EXP_CONFIG_NAME=go1.27.0
